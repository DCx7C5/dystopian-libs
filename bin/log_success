#!/bin/sh

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
LOG_LIB_FILE="/usr/lib/dystopian/libapplog.sh"
[ -f "$LOG_LIB_FILE" ] || LOG_LIB_FILE="$SCRIPT_DIR/../../dystopian-libs/lib/libapplog.sh"
# shellcheck source=../../dystopian-libs/lib/libapplog.sh
[ -f "$LOG_LIB_FILE" ] && . "$LOG_LIB_FILE"
[ "$2" = "INFO" ] && _severity_lvl=isuccess || _severity_lvl=success
_log_message "$_severity_lvl" "$1" "${3:-0}"